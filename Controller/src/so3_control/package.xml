<?xml version="1.0"?>
<package format="3">
  <name>so3_control</name>
  <version>0.0.1</version>
  <description>ROS 2 SO3 position and network attitude controllers with disturbance observer.</description>
  <maintainer email="todo@todo.todo">Kartik Mohta</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>eigen</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>ament_index_python</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
